<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <NeutralLanguage>en</NeutralLanguage>
    <Company>Stanfi1</Company>
    <Product>Obsidian Disassembler</Product>
    <Description>Professional reverse-engineering workspace for native Windows binaries.</Description>
    <Version>0.5.0</Version>
    <Authors>Stanfi1</Authors>
    <Copyright>Copyright (c) 2026 Stanfi1</Copyright>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
