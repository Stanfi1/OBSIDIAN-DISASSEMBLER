<UserControl x:Class="Obsidian.App.Views.CallGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Editor}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="8,6">
      <WrapPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
          <TextBlock Text="FUNCTION" Style="{StaticResource Text.Section}"
                     VerticalAlignment="Center" Margin="0,0,7,0" />
          <TextBlock Text="{Binding FunctionHeader}"
                     FontFamily="{StaticResource Font.Mono}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     MaxWidth="380"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding FunctionHeader}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}"
                   Style="{StaticResource Text.Caption}"
                   VerticalAlignment="Center"
                   Margin="0,0,0,4" />
      </WrapPanel>
    </Border>

    <TextBlock Grid.Row="1"
               Margin="12,8,12,0"
               Style="{StaticResource Text.Caption}"
               Text="Click a caller or callee to re-center the call neighborhood. The graph stays read-only."
               TextWrapping="Wrap" />

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Padding="12,0,12,12">
        <Canvas Width="{Binding GraphWidth}" Height="{Binding GraphHeight}" HorizontalAlignment="Left">
          <ItemsControl ItemsSource="{Binding Edges}" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Path Data="{Binding Geometry}"
                        Stroke="{DynamicResource Brush.Border}"
                        StrokeThickness="1.2"
                        SnapsToDevicePixels="True" />
                  <Polygon Points="{Binding ArrowPoints}"
                           Fill="{DynamicResource Brush.Border}"
                           SnapsToDevicePixels="True" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Nodes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="{Binding Width}"
                        Height="{Binding Height}"
                        Padding="10,6"
                        Cursor="Hand"
                        ToolTip="{Binding ToolTip}"
                        MouseLeftButtonDown="Node_OnMouseLeftButtonDown">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTarget}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                          <Setter Property="BorderThickness" Value="2" />
                          <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding RoleText}"
                               Style="{StaticResource Text.Section}"
                               FontSize="9" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding Title}"
                               Margin="0,2,0,0"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding Subtitle}"
                               Style="{StaticResource Text.Caption}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Canvas>
      </ScrollViewer>

      <Border Background="{DynamicResource Brush.Editor}"
              Visibility="{Binding HasNeighborhood, Converter={StaticResource InverseBoolToVisibility}}">
        <TextBlock Text="No direct callers or callees were discovered for this function."
                   Style="{StaticResource Text.Caption}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="24" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
