<UserControl x:Class="Obsidian.App.Views.PropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{DynamicResource Brush.Panel}">

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl ItemsSource="{Binding Groups}" Margin="12,10,12,16">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" />
              <Border Style="{StaticResource Hairline}" Margin="0,5,0,5" />

              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Label}"
                                 Style="{StaticResource Text.Caption}"
                                 TextWrapping="Wrap"
                                 Margin="0,0,10,0" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Value}"
                                 ToolTip="{Binding ToolTip}"
                                 TextWrapping="Wrap"
                                 TextTrimming="None">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="TextTrimming" Value="None" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsMono}" Value="True">
                                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                                <Setter Property="FontSize" Value="11" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="220"
                Visibility="{Binding HasContent, Converter={StaticResource InverseBoolToVisibility}}">
      <icons:PackIconCodicons Kind="SymbolProperty"
                              Width="26"
                              Height="26"
                              HorizontalAlignment="Center"
                              Foreground="{DynamicResource Brush.TextDisabled}" />
      <TextBlock Text="{Binding EmptyMessage}"
                 Margin="0,10,0,0"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Style="{StaticResource Text.Caption}" />
    </StackPanel>
  </Grid>
</UserControl>
