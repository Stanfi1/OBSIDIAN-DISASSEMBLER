<Window x:Class="Obsidian.App.Views.PatchInstructionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patch instruction"
        Width="620"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}">

  <Border Background="{DynamicResource Brush.Panel}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="34" Background="{DynamicResource Brush.Chrome}" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid>
          <TextBlock Text="Patch instruction"
                     Margin="12,0,46,0"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold" />
          <Button Style="{StaticResource WindowCaptionButton}"
                  Width="34"
                  Height="34"
                  HorizontalAlignment="Right"
                  Tag="Close"
                  Click="Cancel_OnClick"
                  ToolTip="Close">
            <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="20,16,20,14">
        <TextBlock x:Name="AddressText"
                   FontFamily="{StaticResource Font.Mono}"
                   FontSize="12"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="OriginalText"
                   Margin="0,4,0,0"
                   Style="{StaticResource Text.Caption}"
                   FontFamily="{StaticResource Font.Mono}" />

        <TextBlock Text="Replacement bytes"
                   Style="{StaticResource Text.Caption}"
                   Margin="0,16,0,4" />
        <TextBox x:Name="BytesBox"
                 FontFamily="{StaticResource Font.Mono}"
                 FontSize="13"
                 Padding="8,6"
                 TextChanged="BytesBox_OnTextChanged" />
        <TextBlock Text="Hex bytes separated by spaces. The length must match the original instruction so following code does not move."
                   Style="{StaticResource Text.Caption}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0" />

        <Border Margin="0,14,0,0"
                Padding="10,8"
                Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="2">
          <StackPanel>
            <TextBlock Text="DECODED PREVIEW" Style="{StaticResource Text.Caption}" />
            <TextBlock x:Name="PreviewText"
                       Margin="0,4,0,0"
                       FontFamily="{StaticResource Font.Mono}"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Danger}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <TextBlock Text="The patch is applied to an in-memory copy. The original file is never modified; use Save patched copy to write the result."
                   Style="{StaticResource Text.Caption}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />
      </StackPanel>

      <Border Grid.Row="2"
              Background="{DynamicResource Brush.Chrome}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="0,1,0,0"
              Padding="12,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel"
                  Style="{StaticResource SecondaryButton}"
                  MinWidth="78"
                  Margin="0,0,8,0"
                  IsCancel="True"
                  Click="Cancel_OnClick" />
          <Button x:Name="ApplyButton"
                  Content="Apply patch"
                  Style="{StaticResource AccentButton}"
                  MinWidth="96"
                  IsDefault="True"
                  IsEnabled="False"
                  Click="Apply_OnClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
