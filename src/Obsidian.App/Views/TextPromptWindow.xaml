<Window x:Class="Obsidian.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Obsidian Disassembler"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}">

  <Border Background="{DynamicResource Brush.Panel}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="34" Background="{DynamicResource Brush.Chrome}" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid>
          <TextBlock x:Name="TitleText"
                     Margin="12,0,46,0"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <Button Style="{StaticResource WindowCaptionButton}"
                  Width="34"
                  Height="34"
                  HorizontalAlignment="Right"
                  Tag="Close"
                  Click="Cancel_OnClick"
                  ToolTip="Close">
            <icons:PackIconCodicons Kind="ChromeClose" Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="20,16,20,14">
        <TextBlock x:Name="PromptText"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text}" />
        <TextBox x:Name="ValueBox"
                 Margin="0,10,0,0"
                 MinHeight="24"
                 Padding="7,5"
                 VerticalContentAlignment="Center" />
      </StackPanel>

      <Border Grid.Row="2"
              Background="{DynamicResource Brush.Chrome}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="0,1,0,0"
              Padding="12,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel"
                  Style="{StaticResource SecondaryButton}"
                  MinWidth="78"
                  Margin="0,0,8,0"
                  IsCancel="True"
                  Click="Cancel_OnClick" />
          <Button Content="OK"
                  Style="{StaticResource AccentButton}"
                  MinWidth="78"
                  IsDefault="True"
                  Click="Ok_OnClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
