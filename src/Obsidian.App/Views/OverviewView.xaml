<UserControl x:Class="Obsidian.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{DynamicResource Brush.Editor}">

  <UserControl.Resources>
    <DataTemplate x:Key="PropertyGroupTemplate">
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Hairline}" Margin="0,5,0,5" />
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Label}"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,0,10,0"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Value}"
                           ToolTip="{Binding ToolTip}"
                           TextWrapping="Wrap"
                           TextTrimming="None">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                      <Setter Property="TextWrapping" Value="Wrap" />
                      <Setter Property="TextTrimming" Value="None" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMono}" Value="True">
                          <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                          <Setter Property="FontSize" Value="11" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SectionRowTemplate">
      <Grid Margin="0,3" ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="1.2*" />
          <ColumnDefinition Width="0.8*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Name}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Permissions}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding Rva}"
                   Style="{StaticResource Text.Mono}"
                   TextTrimming="None" />
        <TextBlock Grid.Column="2"
                   Text="{Binding Permissions}"
                   Style="{StaticResource Text.Mono}"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   TextTrimming="None" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DirectoryRowTemplate">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="86" />
          <ColumnDefinition Width="66" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding Location}" Style="{StaticResource Text.Mono}" />
        <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FindingRowTemplate">
      <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <icons:PackIconCodicons Grid.Column="0"
                                Width="13"
                                Height="13"
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                Kind="{Binding Severity, Converter={StaticResource FindingIcon}}">
          <icons:PackIconCodicons.Style>
            <Style TargetType="icons:PackIconCodicons">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </icons:PackIconCodicons.Style>
        </icons:PackIconCodicons>
        <StackPanel Grid.Column="1" Margin="0,0,16,0">
          <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" />
          <TextBlock Text="{Binding Detail}"
                     Style="{StaticResource Text.Caption}"
                     TextWrapping="Wrap"
                     TextTrimming="None"
                     Margin="0,2,0,0" />
        </StackPanel>
        <TextBlock Grid.Column="2"
                   Text="{Binding Code}"
                   Style="{StaticResource Text.Mono}"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   VerticalAlignment="Top"
                   TextTrimming="None" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImportRowTemplate">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" Margin="0,0,12,0" />
        <TextBlock Grid.Column="2" Text="{Binding Sample}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExportRowTemplate">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding Ordinal}" Style="{StaticResource Text.Mono}" />
        <TextBlock Grid.Column="2" Text="{Binding Location}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Document header -->
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="24,16,24,13">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding FilePath}"
                     Style="{StaticResource Text.Caption}"
                     ToolTip="{Binding FilePath}"
                     Margin="0,3,0,0" />
          <ItemsControl ItemsSource="{Binding Badges}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource BadgeBorder}">
                  <TextBlock Text="{Binding}" Style="{StaticResource BadgeText}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="24,2,0,0" HorizontalAlignment="Right">
          <TextBlock Text="ENTRY POINT" Style="{StaticResource Text.Section}" HorizontalAlignment="Right" />
          <TextBlock Text="{Binding EntryPointText}"
                     Style="{StaticResource Text.Mono}"
                     FontSize="13"
                     HorizontalAlignment="Right"
                     Margin="0,3,0,0" />
          <TextBlock Text="{Binding EntryPointSection}"
                     Style="{StaticResource Text.Caption}"
                     HorizontalAlignment="Right"
                     Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,18,24,32">

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Image + security properties -->
          <StackPanel Grid.Column="0">
            <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource PropertyGroupTemplate}" />
          </StackPanel>

          <!-- Memory map + section table -->
          <StackPanel Grid.Column="2">
            <TextBlock Text="MEMORY MAP" Style="{StaticResource Text.Section}" />
            <Border Style="{StaticResource Hairline}" Margin="0,5,0,5" />
            <TextBlock Text="{Binding MapHeader}" Style="{StaticResource Text.Caption}" />

            <Viewbox Stretch="Fill" Height="26" Margin="0,8,0,4" HorizontalAlignment="Stretch">
              <Canvas Width="520" Height="26">
                <ItemsControl ItemsSource="{Binding Segments}" Width="520" Height="24">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{Binding Left}" />
                      <Setter Property="Canvas.Top" Value="0" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="{Binding Width}"
                              Height="24"
                              CornerRadius="1"
                              Margin="0,0,1,0"
                              ToolTip="{Binding ToolTip}">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.SectionData}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsUninitialized}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.SectionUninitialized}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsExecutable}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.SectionCode}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Canvas.Left="{Binding EntryMarkerLeft}"
                           Canvas.Top="0"
                           Width="2"
                           Height="26"
                           Fill="{DynamicResource Brush.EntryPoint}" />
              </Canvas>
            </Viewbox>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Rectangle Width="8" Height="8" Fill="{DynamicResource Brush.SectionCode}" VerticalAlignment="Center" />
              <TextBlock Text="Code" Style="{StaticResource Text.Caption}" Margin="5,0,14,0" />
              <Rectangle Width="8" Height="8" Fill="{DynamicResource Brush.SectionData}" VerticalAlignment="Center" />
              <TextBlock Text="Data" Style="{StaticResource Text.Caption}" Margin="5,0,14,0" />
              <Rectangle Width="8" Height="8" Fill="{DynamicResource Brush.SectionUninitialized}" VerticalAlignment="Center" />
              <TextBlock Text="Uninitialized" Style="{StaticResource Text.Caption}" Margin="5,0,14,0" />
              <Rectangle Width="1" Height="10" Fill="{DynamicResource Brush.EntryPoint}" VerticalAlignment="Center" />
              <TextBlock Text="Entry point" Style="{StaticResource Text.Caption}" Margin="5,0,0,0" />
            </StackPanel>

            <Grid Margin="0,4,0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="0.8*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Section" Style="{StaticResource Text.TableHeader}" />
              <TextBlock Grid.Column="1" Text="RVA" Style="{StaticResource Text.TableHeader}" />
              <TextBlock Grid.Column="2" Text="Perm" Style="{StaticResource Text.TableHeader}" />
            </Grid>
            <Border Style="{StaticResource Hairline}" />
            <ItemsControl ItemsSource="{Binding SectionRows}"
                          ItemTemplate="{StaticResource SectionRowTemplate}"
                          Margin="0,2,0,0" />

            <TextBlock Text="DATA DIRECTORIES" Style="{StaticResource Text.Section}" Margin="0,22,0,0" />
            <Border Style="{StaticResource Hairline}" Margin="0,5,0,5" />
            <Grid Margin="0,0,0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="66" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Directory" Style="{StaticResource Text.TableHeader}" />
              <TextBlock Grid.Column="1" Text="RVA" Style="{StaticResource Text.TableHeader}" />
              <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource Text.TableHeader}" HorizontalAlignment="Right" />
            </Grid>
            <Border Style="{StaticResource Hairline}" />
            <ItemsControl ItemsSource="{Binding DirectoryRows}"
                          ItemTemplate="{StaticResource DirectoryRowTemplate}"
                          Margin="0,2,0,0" />
            <TextBlock Text="No data directories are declared."
                       Style="{StaticResource Text.Caption}"
                       Margin="0,6,0,0"
                       Visibility="{Binding HasDirectories, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </Grid>

        <!-- Structural observations -->
        <Grid Margin="0,28,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="STRUCTURAL OBSERVATIONS" Style="{StaticResource Text.Section}" />
            <TextBlock Grid.Column="1"
                       Text="Not a malware verdict"
                       Style="{StaticResource Text.Caption}" />
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Hairline}" Margin="0,5,0,5" />
          <ItemsControl Grid.Row="1"
                        ItemsSource="{Binding Findings}"
                        ItemTemplate="{StaticResource FindingRowTemplate}"
                        Margin="0,4,0,0" />
        </Grid>

        <!-- Imports -->
        <Grid Margin="0,26,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="IMPORTS BY MODULE" Style="{StaticResource Text.Section}" />
          <Border Grid.Row="1" Style="{StaticResource Hairline}" Margin="0,5,0,5" />
          <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Module" Style="{StaticResource Text.TableHeader}" />
              <TextBlock Grid.Column="1" Text="Count" Style="{StaticResource Text.TableHeader}" HorizontalAlignment="Right" Margin="0,0,12,0" />
              <TextBlock Grid.Column="2" Text="Sample symbols" Style="{StaticResource Text.TableHeader}" />
            </Grid>
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding ImportRows}"
                          ItemTemplate="{StaticResource ImportRowTemplate}" />
            <TextBlock Grid.Row="2"
                       Text="{Binding MoreImportsText}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,8,0,0" />
          </Grid>
        </Grid>

        <!-- Exports -->
        <Grid Margin="0,26,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="EXPORTS" Style="{StaticResource Text.Section}" />
          <Border Grid.Row="1" Style="{StaticResource Hairline}" Margin="0,5,0,5" />
          <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Symbol" Style="{StaticResource Text.TableHeader}" />
              <TextBlock Grid.Column="1" Text="Ordinal" Style="{StaticResource Text.TableHeader}" />
              <TextBlock Grid.Column="2" Text="Location" Style="{StaticResource Text.TableHeader}" />
            </Grid>
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding ExportRows}"
                          ItemTemplate="{StaticResource ExportRowTemplate}" />
            <TextBlock Grid.Row="1"
                       Text="This image exports no symbols."
                       Style="{StaticResource Text.Caption}"
                       Margin="0,6,0,0"
                       Visibility="{Binding HasExports, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBlock Grid.Row="2"
                       Text="{Binding MoreExportsText}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,8,0,0" />
          </Grid>
        </Grid>

        <TextBlock Text="Values are read directly from the PE container. No code was executed."
                   Style="{StaticResource Text.Caption}"
                   Margin="0,28,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
