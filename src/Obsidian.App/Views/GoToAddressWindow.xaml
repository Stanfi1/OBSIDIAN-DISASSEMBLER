<Window x:Class="Obsidian.App.Views.GoToAddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Go to address"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}">

  <Border Background="{DynamicResource Brush.Panel}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="34" Background="{DynamicResource Brush.Chrome}" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid>
          <TextBlock Text="Go to address" Margin="12,0,46,0" VerticalAlignment="Center" FontWeight="SemiBold" />
          <Button Style="{StaticResource WindowCaptionButton}"
                  Width="34"
                  Height="34"
                  HorizontalAlignment="Right"
                  Tag="Close"
                  Click="Cancel_OnClick">
            <icons:PackIconCodicons Kind="ChromeClose" Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="22,18,22,18">
        <TextBlock Text="ADDRESS" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Hairline}" Margin="0,5,0,8" />
        <Grid>
          <TextBox x:Name="AddressInput"
                   Height="30"
                   FontFamily="{StaticResource Font.Mono}"
                   FontSize="13"
                   Padding="8,5"
                   TextChanged="Input_OnChanged"
                   ToolTip="Hexadecimal address. Prefix 0x is optional." />
          <TextBlock Text="0x00007FF6A1B2C3D4"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=AddressInput}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <TextBlock Text="Interpret the value as"
                   Style="{StaticResource Text.Caption}"
                   Margin="0,10,0,4" />
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="RvaOption" Content="RVA" IsChecked="True" GroupName="Space" Checked="Input_OnChanged" Margin="0,0,18,0" />
          <RadioButton x:Name="VaOption" Content="Virtual address" GroupName="Space" Checked="Input_OnChanged" Margin="0,0,18,0" />
          <RadioButton x:Name="OffsetOption" Content="File offset" GroupName="Space" Checked="Input_OnChanged" />
        </StackPanel>

        <Border Background="{DynamicResource Brush.PanelAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                Padding="10,8"
                Margin="0,14,0,0">
          <StackPanel>
            <TextBlock x:Name="PreviewText"
                       Text="Enter an address to resolve it."
                       Style="{StaticResource Text.Mono}"
                       TextWrapping="Wrap"
                       TextTrimming="None" />
            <TextBlock x:Name="SectionText"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       TextTrimming="None" />
          </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText"
                   Foreground="{DynamicResource Brush.Danger}"
                   FontSize="11"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   TextTrimming="None" />
      </StackPanel>

      <Border Grid.Row="2"
              Background="{DynamicResource Brush.Chrome}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="0,1,0,0"
              Padding="12,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel"
                  Style="{StaticResource SecondaryButton}"
                  MinWidth="86"
                  Margin="0,0,8,0"
                  IsCancel="True"
                  Click="Cancel_OnClick" />
          <Button x:Name="GoButton"
                  Content="Go"
                  Style="{StaticResource AccentButton}"
                  MinWidth="86"
                  IsDefault="True"
                  IsEnabled="False"
                  Click="Go_OnClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
