<Window x:Class="Obsidian.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Settings"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}">

  <Border Background="{DynamicResource Brush.Panel}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="34" Background="{DynamicResource Brush.Chrome}" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
        <Grid>
          <TextBlock Text="Settings" Margin="12,0,46,0" VerticalAlignment="Center" FontWeight="SemiBold" />
          <Button Style="{StaticResource WindowCaptionButton}"
                  Width="34"
                  Height="34"
                  HorizontalAlignment="Right"
                  Tag="Close"
                  Click="Cancel_OnClick"
                  ToolTip="Close">
            <icons:PackIconCodicons Kind="ChromeClose" Width="10" Height="10" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="22,18,22,16">
        <TextBlock Text="APPEARANCE" Style="{StaticResource Text.Section}" />
        <Border Style="{StaticResource Hairline}" Margin="0,5,0,10" />
        <RadioButton Content="Dark theme"
                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                     GroupName="Theme"
                     Margin="0,2,0,4" />
        <RadioButton Content="Light theme"
                     IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                     GroupName="Theme"
                     Margin="0,2,0,4" />

        <TextBlock Text="WINDOW" Style="{StaticResource Text.Section}" Margin="0,22,0,0" />
        <Border Style="{StaticResource Hairline}" Margin="0,5,0,10" />
        <CheckBox Content="Remember window size and position"
                  IsChecked="{Binding RememberWindowSize, Mode=TwoWay}" />
        <TextBlock Text="Applied the next time the application starts."
                   Style="{StaticResource Text.Caption}"
                   Margin="22,4,0,0" />

        <TextBlock Text="DATA" Style="{StaticResource Text.Section}" Margin="0,22,0,0" />
        <Border Style="{StaticResource Hairline}" Margin="0,5,0,10" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Local data" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding DataDirectory}"
                     Style="{StaticResource Text.Mono}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding DataDirectory}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="2"
                  Content="Open"
                  Style="{StaticResource SecondaryButton}"
                  Padding="10,4"
                  Click="OpenDataFolder_OnClick" />
        </Grid>
        <TextBlock Text="Settings, recent files and logs are stored locally. No telemetry is sent."
                   Style="{StaticResource Text.Caption}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   TextTrimming="None" />

        <TextBlock Text="ABOUT THIS BUILD" Style="{StaticResource Text.Section}" Margin="0,22,0,0" />
        <Border Style="{StaticResource Hairline}" Margin="0,5,0,10" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Version" Style="{StaticResource Text.Caption}" />
          <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource Text.Mono}" />
        </Grid>
        <TextBlock Text="Obsidian Disassembler · 0.5 professional workflow (projects, annotations, patching)"
                   Style="{StaticResource Text.Caption}"
                   Margin="0,4,0,0" />
      </StackPanel>

      <Border Grid.Row="2"
              Background="{DynamicResource Brush.Chrome}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="0,1,0,0"
              Padding="12,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel"
                  Style="{StaticResource SecondaryButton}"
                  MinWidth="86"
                  Margin="0,0,8,0"
                  IsCancel="True"
                  Click="Cancel_OnClick" />
          <Button Content="Save"
                  Style="{StaticResource AccentButton}"
                  MinWidth="86"
                  IsDefault="True"
                  Click="Save_OnClick" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
