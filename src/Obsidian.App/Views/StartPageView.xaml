<UserControl x:Class="Obsidian.App.Views.StartPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{DynamicResource Brush.Editor}">

  <UserControl.Resources>
    <Style x:Key="RecentItemButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MaxWidth="1080" Margin="40,36,40,28" HorizontalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Identity -->
      <Grid Grid.Row="0" Margin="0,0,0,32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Source="pack://application:,,,/Assets/obsidian-logo.png"
               Width="44"
               Height="44"
               Margin="0,2,16,0"
               VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <StackPanel Grid.Column="1">
          <TextBlock Text="OBSIDIAN DISASSEMBLER" Style="{StaticResource Text.Section}" />
          <TextBlock Text="Reverse engineering workspace"
                     Style="{StaticResource Text.Display}"
                     Margin="0,4,0,0" />
          <TextBlock Text="Portable Executable inspection and native code analysis for Windows binaries."
                     Style="{StaticResource Text.Secondary}"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap"
                     TextTrimming="None" />
        </StackPanel>
      </Grid>

      <!-- Start / recent and environment. Wraps to a single column when the
           document area is narrow instead of squeezing both columns. -->
      <WrapPanel Grid.Row="1" Orientation="Horizontal">
        <StackPanel Width="440" Margin="0,0,36,24">
          <TextBlock Text="START" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />

          <Button Command="{Binding OpenBinaryCommand}"
                  Style="{StaticResource AccentButton}"
                  HorizontalAlignment="Left"
                  Padding="16,7">
            <StackPanel Orientation="Horizontal">
              <icons:PackIconCodicons Kind="RootFolderOpened"
                                      Width="15"
                                      Height="15"
                                      Margin="0,0,8,0"
                                      Foreground="{DynamicResource Brush.AccentText}" />
              <TextBlock Text="Open binary…"
                         Foreground="{DynamicResource Brush.AccentText}"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Button>

          <TextBlock Text="Open a PE32 or PE32+ file. Analysis runs off the UI thread."
                     Style="{StaticResource Text.Caption}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     TextTrimming="None" />

          <Grid Margin="0,26,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="RECENT BINARIES" Style="{StaticResource Text.Section}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding RecentFiles.Count, StringFormat={}{0}}"
                       Style="{StaticResource Text.Caption}" />
          </Grid>

          <Border Style="{StaticResource Hairline}" />

          <ItemsControl ItemsSource="{Binding RecentFiles}" Margin="0,4,0,0">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource RecentItemButton}"
                        ToolTip="{Binding Path}"
                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Path}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <icons:PackIconCodicons Grid.Column="0"
                                            Kind="FileBinary"
                                            Width="14"
                                            Height="14"
                                            Margin="0,2,6,0"
                                            VerticalAlignment="Top"
                                            Foreground="{DynamicResource Brush.Icon}" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                      <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Text="{Binding Directory}"
                                 Style="{StaticResource Text.Caption}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding LastOpenedText}"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Margin="8,12,0,0"
                      Visibility="{Binding HasRecentFiles, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="No recent binaries." Style="{StaticResource Text.Secondary}" />
            <TextBlock Text="Opened files appear here and in File → Open Recent."
                       Style="{StaticResource Text.Caption}"
                       Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>

        <StackPanel Width="340">
          <TextBlock Text="ENVIRONMENT" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />

          <Border Style="{StaticResource Hairline}" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Style="{StaticResource Text.Caption}" Margin="0,4" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource Text.Mono}" Margin="0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime" Style="{StaticResource Text.Caption}" Margin="0,4" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeDescription}" Style="{StaticResource Text.Caption}" Margin="0,4" TextWrapping="Wrap" TextTrimming="None" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Process" Style="{StaticResource Text.Caption}" Margin="0,4" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProcessArchitecture}" Style="{StaticResource Text.Caption}" Margin="0,4" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Operating system" Style="{StaticResource Text.Caption}" Margin="0,4" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OsDescription}" Style="{StaticResource Text.Caption}" Margin="0,4" TextWrapping="Wrap" TextTrimming="None" />
          </Grid>

          <TextBlock Text="KEYBOARD" Style="{StaticResource Text.Section}" Margin="0,28,0,10" />
          <Border Style="{StaticResource Hairline}" />
          <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Gesture}" Style="{StaticResource Text.Mono}" />
                  <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Text.Caption}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </WrapPanel>

      <!-- Footer -->
      <Grid Grid.Row="3" Margin="0,32,0,0">
        <Border Style="{StaticResource Hairline}" VerticalAlignment="Top" />
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="Obsidian 0.5 · PE inspection, disassembly, analysis, projects, call/control-flow graphs and validated patching."
                     Style="{StaticResource Text.Caption}" />
          <TextBlock Grid.Column="1"
                     Text="C# · WPF · .NET 10"
                     Style="{StaticResource Text.Caption}" />
        </Grid>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
