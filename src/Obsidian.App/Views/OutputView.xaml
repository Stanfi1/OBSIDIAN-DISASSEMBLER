<UserControl x:Class="Obsidian.App.Views.OutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{DynamicResource Brush.Panel}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="0,0,0,1"
            Padding="6,3">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0"
                Style="{StaticResource PanelToolButton}"
                Command="{Binding ClearCommand}"
                ToolTip="Clear output">
          <icons:PackIconCodicons Kind="ClearAll" Width="12" Height="12" />
        </Button>
        <Button Grid.Column="1"
                Style="{StaticResource PanelToolButton}"
                Command="{Binding CopyAllCommand}"
                ToolTip="Copy all output">
          <icons:PackIconCodicons Kind="Copy" Width="12" Height="12" />
        </Button>
        <Button Grid.Column="2"
                Style="{StaticResource PanelToolButton}"
                Command="{Binding OpenLogFolderCommand}"
                ToolTip="Open log folder">
          <icons:PackIconCodicons Kind="FolderActive" Width="12" Height="12" />
        </Button>

        <TextBlock Grid.Column="4"
                   Text="{Binding Entries.Count, StringFormat={}{0} entries}"
                   Style="{StaticResource Text.Caption}"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <ListBox ItemsSource="{Binding Entries}"
               x:Name="OutputList"
               Padding="0,2,0,2"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="8,0,6,0" Height="19">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding TimeText}"
                         Style="{StaticResource Text.Mono}"
                         Foreground="{DynamicResource Brush.TextMuted}"
                         TextTrimming="None" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Level}"
                         FontFamily="{StaticResource Font.UI}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         TextTrimming="None">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Level}" Value="Debug">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Level}" Value="Information">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Level}" Value="Warning">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Level}" Value="Error">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Level}" Value="Fatal">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Column="2"
                         Text="{Binding Message}"
                         Style="{StaticResource Text.Mono}"
                         ToolTip="{Binding DisplayText}"
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="No output yet."
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Style="{StaticResource Text.Caption}"
                 Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
