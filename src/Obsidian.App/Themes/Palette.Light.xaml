  <SolidColorBrush x:Key="Brush.EntryPoint" Color="#8A6D00" />

  <SolidColorBrush x:Key="Brush.Syntax.Keyword" Color="#0000FF" />
  <SolidColorBrush x:Key="Brush.Syntax.Type" Color="#267F99" />
  <SolidColorBrush x:Key="Brush.Syntax.String" Color="#A31515" />
  <SolidColorBrush x:Key="Brush.Syntax.Comment" Color="#008000" />
  <SolidColorBrush x:Key="Brush.Syntax.Number" Color="#098658" />
  <SolidColorBrush x:Key="Brush.Syntax.Function" Color="#795E26" />
  <SolidColorBrush x:Key="Brush.Syntax.Register" Color="#001080" />
  <SolidColorBrush x:Key="Brush.Syntax.Address" Color="#098658" />
