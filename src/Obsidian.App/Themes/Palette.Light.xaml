  <SolidColorBrush x:Key="Brush.TextMuted" Color="#666666" />
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="#9A9A9A" />
  <SolidColorBrush x:Key="Brush.Icon" Color="#555555" />

  <SolidColorBrush x:Key="Brush.Accent" Color="#005FB8" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#1877C9" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.AccentMuted" Color="#8CC4EE" />

  <SolidColorBrush x:Key="Brush.Success" Color="#107C10" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#8A6D00" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C" />
  <SolidColorBrush x:Key="Brush.Info" Color="#005FB8" />

  <SolidColorBrush x:Key="Brush.Badge" Color="#E8E8E8" />
