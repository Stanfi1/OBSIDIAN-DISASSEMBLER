<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Obsidian Disassembler · light palette -->

  <SolidColorBrush x:Key="Brush.Window" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Brush.Chrome" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Brush.Panel" Color="#F8F8F8" />
  <SolidColorBrush x:Key="Brush.PanelAlt" Color="#F0F0F0" />
  <SolidColorBrush x:Key="Brush.Editor" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Popup" Color="#FFFFFF" />

  <SolidColorBrush x:Key="Brush.Hover" Color="#E8E8E8" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="#DCDCDC" />
  <SolidColorBrush x:Key="Brush.Selected" Color="#CCE4F7" />
  <SolidColorBrush x:Key="Brush.SelectedInactive" Color="#E4E4E4" />
  <SolidColorBrush x:Key="Brush.Selection" Color="#ADD6FF" />

  <SolidColorBrush x:Key="Brush.Border" Color="#D6D6D6" />
