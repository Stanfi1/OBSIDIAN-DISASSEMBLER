<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Obsidian Disassembler · dark palette
       Values deliberately close to Visual Studio 2022 dark so AvalonDock's
       VS2022 theme and the custom shell read as one product. -->

  <SolidColorBrush x:Key="Brush.Window" Color="#1F1F1F" />
  <SolidColorBrush x:Key="Brush.Chrome" Color="#2D2D30" />
  <SolidColorBrush x:Key="Brush.Panel" Color="#252526" />
  <SolidColorBrush x:Key="Brush.PanelAlt" Color="#2A2A2B" />
  <SolidColorBrush x:Key="Brush.Editor" Color="#1E1E1E" />
  <SolidColorBrush x:Key="Brush.Input" Color="#1E1E1E" />
  <SolidColorBrush x:Key="Brush.Popup" Color="#252526" />

  <SolidColorBrush x:Key="Brush.Hover" Color="#3E3E42" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="#4B4B50" />
  <SolidColorBrush x:Key="Brush.Selected" Color="#094771" />
  <SolidColorBrush x:Key="Brush.SelectedInactive" Color="#37373D" />
  <SolidColorBrush x:Key="Brush.Selection" Color="#264F78" />

  <SolidColorBrush x:Key="Brush.Border" Color="#3F3F46" />
  <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#333337" />
  <SolidColorBrush x:Key="Brush.ScrollTrack" Color="Transparent" />
  <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#4A4A4F" />
  <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#5A5A60" />

  <SolidColorBrush x:Key="Brush.Text" Color="#F1F1F1" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#CCCCCC" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#A0A0A0" />
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="#6B6B6B" />
  <SolidColorBrush x:Key="Brush.Icon" Color="#C8C8C8" />

  <SolidColorBrush x:Key="Brush.Accent" Color="#007ACC" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#1C97EA" />
  <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.AccentMuted" Color="#0E639C" />

  <SolidColorBrush x:Key="Brush.Success" Color="#89D185" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#CCA700" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#F14C4C" />
  <SolidColorBrush x:Key="Brush.Info" Color="#75BEFF" />

  <SolidColorBrush x:Key="Brush.Badge" Color="#333337" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="#A6000000" />
  <SolidColorBrush x:Key="Brush.CaptionCloseHover" Color="#C42B1C" />

  <SolidColorBrush x:Key="Brush.SectionCode" Color="#0E639C" />
  <SolidColorBrush x:Key="Brush.SectionData" Color="#5A5A64" />
  <SolidColorBrush x:Key="Brush.SectionUninitialized" Color="#3A3A40" />
  <SolidColorBrush x:Key="Brush.EntryPoint" Color="#CCA700" />

  <!-- Syntax tokens reserved for the disassembly and decompiler surfaces. -->
  <SolidColorBrush x:Key="Brush.Syntax.Keyword" Color="#569CD6" />
  <SolidColorBrush x:Key="Brush.Syntax.Type" Color="#4EC9B0" />
  <SolidColorBrush x:Key="Brush.Syntax.String" Color="#CE9178" />
  <SolidColorBrush x:Key="Brush.Syntax.Comment" Color="#6A9955" />
  <SolidColorBrush x:Key="Brush.Syntax.Number" Color="#B5CEA8" />
  <SolidColorBrush x:Key="Brush.Syntax.Function" Color="#DCDCAA" />
  <SolidColorBrush x:Key="Brush.Syntax.Register" Color="#9CDCFE" />
  <SolidColorBrush x:Key="Brush.Syntax.Address" Color="#B5CEA8" />
</ResourceDictionary>
