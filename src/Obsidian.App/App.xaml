<Application x:Class="Obsidian.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Obsidian.App.Converters"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
        <ResourceDictionary Source="Themes/Menu.xaml" />
        <ResourceDictionary Source="Themes/TreeView.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <conv:InverseBooleanConverter x:Key="InverseBool" />
      <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
      <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
      <conv:StringToVisibilityConverter x:Key="EmptyStringToVisibility" Invert="True" />
      <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
      <conv:NullToVisibilityConverter x:Key="NotNullToVisibility" Invert="True" />
      <conv:ExplorerIconConverter x:Key="ExplorerIcon" />
      <conv:FindingIconConverter x:Key="FindingIcon" />
      <conv:HexRvaConverter x:Key="HexRva" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
