<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Binary formats -->
    <PackageVersion Include="AsmResolver" Version="6.1.0" />
    <PackageVersion Include="AsmResolver.PE" Version="6.1.0" />
    <PackageVersion Include="AsmResolver.PE.File" Version="6.1.0" />

    <!-- Native disassembly -->
    <PackageVersion Include="Iced" Version="1.22.0" />

    <!-- Shell / docking / icons -->
    <PackageVersion Include="Dirkster.AvalonDock" Version="5.0.2" />
    <PackageVersion Include="Dirkster.AvalonDock.Themes.VS" Version="5.0.2" />
    <PackageVersion Include="MahApps.Metro.IconPacks.Codicons" Version="6.2.1" />

    <!-- Infrastructure -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
